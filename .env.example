# ── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://myshowroom:myshowroom@localhost:5432/myshowroom"

# ── Application ────────────────────────────────────────────
# Public base URL (used in emails and booking links)
APP_URL="http://localhost:3000"
# Local directory for uploaded files (images, PDFs). Not publicly served:
# every file is streamed through an authorised route.
STORAGE_DIR="./storage"

# ── Initial administrator (used only by `npm run db:seed`) ─
# If SEED_ADMIN_PASSWORD is empty a random password is generated and printed.
SEED_ADMIN_EMAIL="admin@peverellidesign.com"
SEED_ADMIN_PASSWORD=""
# Password assigned to the demo users (manager, consultant, warehouse).
# If empty, demo users get random passwords printed by the seed.
SEED_DEMO_PASSWORD=""

# ── Email (SMTP) ───────────────────────────────────────────
# Leave SMTP_HOST empty to disable sending: drafts can still be saved/copied.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Peverelli Design <showroom@peverellidesign.com>"

# ── AI assistant (Ask myshowroom) ──────────────────────────
# Leave empty to use the built-in structured search fallback.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
