# ── Database: UNA delle due opzioni ───────────────────────────
# A) API HTTPS di Supabase (obbligatoria su GoDaddy Node.js Hosting)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# B) Connessione diretta PostgreSQL
DATABASE_URL=postgres://myshowroom:password@localhost:5432/myshowroom
# Supabase: Project → Connect → "Session pooler" (SSL attivato automaticamente)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host-pooler>.pooler.supabase.com:5432/postgres
# DB_SSL=require            # forza SSL per altri database gestiti
# DB_PREPARE=false          # solo con pooler in modalità transaction (porta 6543); automatico su 6543

# Primo amministratore (usato solo quando il database è vuoto)
ADMIN_EMAIL=admin@tuodominio.com
ADMIN_PASSWORD=cambiami-subito-123
ADMIN_NAME=Direzione Peverelli

PORT=3000
PUBLIC_URL=https://myshowroom.tuodominio.com
SEED_DEMO=false             # true = carica i 4 prodotti dimostrativi
PUBLIC_BOOKING=true         # pagine pubbliche /book/como, /book/lugano, …
MAX_UPLOAD_MB=100

# ── Archivio file (PDF cataloghi, immagini, preventivi) ───────
STORAGE=disk                # disk | s3
UPLOAD_DIR=./data/uploads
# Supabase Storage (bucket privato + chiavi da Storage → Settings → S3):
# STORAGE=s3
# S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1    # la regione del progetto Supabase
# S3_BUCKET=myshowroom
# S3_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MAX_UPLOAD_MB=50          # limite per file del piano Free di Supabase
#
# STORAGE=s3                # AWS S3, Cloudflare R2, Backblaze B2, MinIO, Scaleway…
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=myshowroom
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true        # per R2/MinIO
# S3_PREFIX=prod

# ── Email ─────────────────────────────────────────────────────
# MAIL_PROVIDER=godaddy     # gateway email interno di GoDaddy Node.js Hosting
# APP_SECRET=               # firma dei link di download inviati per email
# Outlook / Microsoft 365 via Microsoft Graph (consigliato su Railway; vedi README):
# MAIL_PROVIDER=microsoft
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MAIL_FROM=Peverelli Design <showroom@tuodominio>

# Oppure SMTP (senza SMTP né gateway le email restano "non consegnate"):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=showroom@tuodominio.com
# SMTP_PASS=
# MAIL_FROM=Peverelli Design <showroom@tuodominio.com>

# ── Assistente (facoltativo: senza chiave usa la ricerca locale) ─
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
