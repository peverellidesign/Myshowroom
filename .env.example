# ── Obbligatorio ──────────────────────────────────────────────
DATABASE_URL=postgres://myshowroom:password@localhost:5432/myshowroom
# DB_SSL=require            # per database gestiti (Neon, Supabase, RDS…)

# Primo amministratore (usato solo quando il database è vuoto)
ADMIN_EMAIL=admin@tuodominio.com
ADMIN_PASSWORD=cambiami-subito-123
ADMIN_NAME=Direzione Peverelli

PORT=3000
PUBLIC_URL=https://myshowroom.tuodominio.com
SEED_DEMO=false             # true = carica i 4 prodotti dimostrativi
PUBLIC_BOOKING=true         # pagine pubbliche /book/como, /book/lugano, …
MAX_UPLOAD_MB=100

# ── Archivio file (PDF cataloghi, immagini, preventivi) ───────
STORAGE=disk                # disk | s3
UPLOAD_DIR=./data/uploads
# STORAGE=s3                # AWS S3, Cloudflare R2, Backblaze B2, MinIO, Scaleway…
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=myshowroom
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true        # per R2/MinIO
# S3_PREFIX=prod

# ── Email (senza SMTP le email restano "non consegnate") ──────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=showroom@tuodominio.com
# SMTP_PASS=
# MAIL_FROM=Peverelli Design <showroom@tuodominio.com>

